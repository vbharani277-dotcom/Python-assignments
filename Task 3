import sqlite3,time,re
from collections import Counter
POSITIVE={"good","clean","fast","helpful","improved"}
NEGATIVE={"bad","dirty","slow","rude","smoke","broken"}
NEGATORS={"not","never","no"}

def score(text):
	words=re.sub(r'\W',' ',text.lower()).replace(",","").split()
	total=0; previous_negator=False
	for word in words:
		value=1 if word in POSITIVE else -1 if word in NEGATIVE else 0
		if value and previous_negator: value=-value
		total+=value
		previous_negator=word in NEGATORS
	return total

def label(text):
	s=score(text)
	return "positive" if s>0 else "negative" if s<0 else "neutral"

STOP={"the","is","are","a","an","and","of","to","in","on","was","were"}
def summarise(textL):
	sentences=[x.strip() for x in re.split(r"(?<![0-9])\. ",text) if x.strip()]
	words=re.findall(r"[A-Za-z]+",text.lower())
	freq=Counter(w for w in words if w not in STOP)
	ranked=sorted(enumerate(sentences),
		key=lambda k:-sum(freq[w.lower()] for w in re.findall(r"[A-Za-z]+",k[1]))
	)
	return ". ".join(x for s,x in sorted(ranked[:2]))

